# TradeStation API Credentials
# Copy this file to .env and fill in your actual credentials

# API Key and Secret from TradeStation Developer Portal
TRADESTATION_API_KEY=your_api_key_here
TRADESTATION_SECRET=your_api_secret_here

# Refresh Token (obtained through OAuth flow - see tradestation/ts_api_demo.ipynb)
# This token lasts indefinitely until revoked
REFRESH_TOKEN=your_refresh_token_here

# Account ID
# For simulation: SIM#######M (e.g., SIM2977785M)
# For production: Your real TradeStation account number
ACCOUNT_ID=your_account_id_here

# Note: The same credentials work for both simulation and production.
# When creating the API, specify environment='sim' or environment='prod'
# to determine which API endpoint to use:
#   - 'sim': https://sim-api.tradestation.com (paper trading)
#   - 'prod': https://api.tradestation.com (REAL MONEY)
